+ const partners=await f.gateway.search(42,'Alex');assert.equal('email'in partners[0],false);
+ await f.gateway.submit(42,await quoted(f),'WITH_PARTNER',partners[0],false);
+ assert.deepEqual(f.state.writes[0].body,{nombre:'Alex',apellido:'Test',existingUserId:20,isExistingUser:true});
+});
+test('self, missing phone, individual events, closed or started event never send a pair registration',async()=>{
