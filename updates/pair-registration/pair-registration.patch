+ await assert.rejects(f.gateway.submit(42,await quoted(f),'WITH_PARTNER',f.partner,false),e=>e.code==='MATCH_REQUIRED'&&e.matches.length===2);
+ assert.equal(f.state.writes.length,0);
+});
