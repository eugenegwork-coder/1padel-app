+ const f=fixture();let reply;f.transport.pairWrite=()=>{f.state.writes.push({});return new Promise(resolve=>{reply=resolve;});};const g=createPairBooking(f.transport,4);const q=pairQuote(await g.load(42));
+ const first=g.submit(42,q,'WITH_PARTNER',f.partner,false);await assert.rejects(g.submit(42,q,'WITH_PARTNER',f.partner,false),{code:'BUSY'});
