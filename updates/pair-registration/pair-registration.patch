+ await assert.rejects(f.gateway.submit(42,await quoted(f),'WITH_PARTNER',{...f.partner,id:4},false));assert.equal(f.state.writes.length,0);
+});
+test('changed conditions or newly created own request require another review, zero POST',async()=>{
+ for(const change of [{price:32000},{available:0}]){const f=fixture();const q=await quoted(f);Object.assign(f.state.event,change);
+ await assert.rejects(f.gateway.submit(42,q,'WITH_PARTNER',f.partner,false),{code:'CHANGED'});assert.equal(f.state.writes.length,0);}
