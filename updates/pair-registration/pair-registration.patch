+ const f=fixture();const q=await quoted(f);assert.equal(f.state.writes.length,0);
+ const receipt=await f.gateway.submit(42,q,'WITH_PARTNER',f.partner,false);
+ assert.equal(receipt.status,'CONFIRMED');assert.equal(f.state.writes.length,1);
+ assert.equal(f.state.writes[0].action,'register');assert.equal('email' in f.state.writes[0].body,false);assert.equal('playerId' in f.state.writes[0].body,false);
