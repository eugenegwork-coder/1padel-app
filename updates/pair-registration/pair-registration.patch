+import React,{useMemo,useState} from 'react';
+import {ScrollView,Text,TouchableOpacity,View} from 'react-native';
+import {SafeAreaProvider,SafeAreaView} from 'react-native-safe-area-context';
+import PairBookingScreen from './PairBookingScreen';
+import {createPairBooking} from './pairBooking';
+import type {PublicTournament} from './schedule';
+import type {Language} from './schedule';
+import {AuthError} from './auth';
+import {colors as c} from './theme';
+const scenarios=['Готовая пара','Резерв','Добавить партнёра','Поиск пары','Обрыв связи','Изменилась цена'] as const;
+type Scenario=typeof scenarios[number];
+function laboratory(scenario:Scenario,onWrite:()=>void){
+ const event:PublicTournament={id:90002,name:'Test pair',type:'AMERICANO_TEAMS',modality:'DOBLES',gender:'MASCULINO',level:'C9',club:{id:1,name:'Тестовый клуб',address:null},startsAt:new Date(Date.now()+7*86400000).toISOString(),timeZone:'America/Argentina/Buenos_Aires',duration:'3h',price:30000,currency:'ARS',status:'REGISTRO_ABIERTO',capacity:12,occupied:scenario==='Резерв'?12:8,available:scenario==='Резерв'?0:4,capacityUnit:'PAIRS',registrationOpen:true,waitlistCount:2,cancellationDeadline:null,description:null,websiteUrl:'https://1-padel.com/'};
+ let own:Record<string,unknown>={registered:false};let reads=0;
+ const partners=[{id:20,nombre:'Алекс',apellido:'Морено',telefono:'+54 9 11 0000 0101',telegramUsername:'@alex_demo',nivelJugador:'C9'},{id:21,nombre:'Алекс',apellido:'Перес',telefono:'+54 9 11 0000 0102',telegramUsername:'@alex_perez_demo',nivelJugador:'C8'}];
+ const record=(status:string,isDouble=false,name:string|null=null)=>({registered:true,registrationId:123,status,isDoubleRegistration:isDouble,partnerId:isDouble?20:null,partnerFirstName:name,partnerLastName:null,waitlistPosition:status==='WAITLIST'?3:null,registrationDate:'2026-10-22T09:00:00'});
+ if(scenario==='Добавить партнёра')own=record('WAITLIST');if(scenario==='Поиск пары')own=record('SOLO_SEARCH');
+ const gateway=createPairBooking({sessionVersion:()=>1,details:async()=>{if(scenario==='Изменилась цена'&&++reads>=2)event.price=32000;return {...event};},pairOwn:async()=>({...own}),searchPartners:async(_id,q)=>partners.filter(p=>[p.nombre,p.apellido,p.telefono,p.telegramUsername].some(s=>s.toLowerCase().replace(/[^a-zа-я0-9]/g,'').includes(q.toLowerCase().replace(/[^a-zа-я0-9]/g,'')))),pairCandidates:async()=>[{registrationId:200,playerId:30,playerName:'Даниэль Тестовый',nivel:'C9',shareContacts:false}],pairWrite:async(_id,action,body)=>{onWrite();const b=body as Record<string,unknown>;const status=action==='register-solo'?b.soloType==='SEARCH'?'SOLO_SEARCH':'SOLO_ADD_LATER':scenario==='Резерв'||scenario==='Добавить партнёра'?'WAITLIST':'CONFIRMED';own=record(status,action!=='register-solo',action==='register-solo'?null:`${b.nombre} ${b.apellido}`);if(scenario==='Обрыв связи')throw new AuthError('NETWORK');return {success:true,status,waitlistPosition:status==='WAITLIST'?3:null};},proposePair:async()=>{onWrite();return {success:true};}},4);
+ return gateway;
+}
+export default function PairBookingLab(){const [scenario,setScenario]=useState<Scenario>('Готовая пара');const [writes,setWrites]=useState(0);const [language,setLanguage]=useState<Language>('ru');const [closed,setClosed]=useState(false);const gateway=useMemo(()=>laboratory(scenario,()=>setWrites(v=>v+1)),[scenario]);
+ return <SafeAreaProvider><SafeAreaView style={{flex:1,backgroundColor:c.white}}><View style={{padding:12,flexDirection:'row',justifyContent:'space-between'}}><Text style={{fontWeight:'800',color:c.ink}}>1-PADEL · проверка подключения</Text>{(['ru','es','en']as Language[]).map(l=><TouchableOpacity accessibilityRole="button" key={l} onPress={()=>setLanguage(l)}><Text>{l.toUpperCase()}</Text></TouchableOpacity>)}</View><ScrollView horizontal style={{flexGrow:0,maxHeight:48}} contentContainerStyle={{gap:8,padding:8}}>{scenarios.map(value=><TouchableOpacity key={value} accessibilityRole="tab" onPress={()=>{setScenario(value);setWrites(0);setClosed(false);}} style={{padding:9,backgroundColor:scenario===value?c.greenPale:c.white,borderRadius:12}}><Text>{value}</Text></TouchableOpacity>)}</ScrollView><Text style={{padding:8,fontSize:10}}>Тестовых отправок: {writes}</Text>{closed?<View style={{padding:20}}><Text>Мои мероприятия · тест</Text><TouchableOpacity accessibilityRole="button" onPress={()=>setClosed(false)}><Text>Вернуться к заявке</Text></TouchableOpacity></View>:<PairBookingScreen key={scenario} tournamentId={90002} gateway={gateway} language={language} profileName="Игрок · тестовый аккаунт" demo onClose={()=>setClosed(true)} onMyEvents={()=>setClosed(true)}/>}</SafeAreaView></SafeAreaProvider>;
+}
