+import type {Candidate,Partner,PairMode,PairSnapshot,PairReceipt,createPairBooking} from './pairBooking';
+import {pairCopy} from './pairCopy';
+import {eventDate,eventPrice} from './schedule';
+import type {Language} from './schedule';
+import {messages} from './copy';
+import {cancellationDeadline} from './individualBooking';
+import {colors as c} from './theme';
+type Phase='choose'|'partner'|'solo'|'review'|'result'|'candidates'|'proposal';
+type FieldKey='first'|'last'|'phone'|'telegram';
+export default function PairBookingScreen({tournamentId,gateway,language,profileName,onClose,onMyEvents,demo=false}:{tournamentId:number;gateway:ReturnType<typeof createPairBooking>;language:Language;profileName:string;onClose:()=>void;onMyEvents:()=>void;demo?:boolean}) {
+ const t=pairCopy[language]; const [snapshot,setSnapshot]=useState<PairSnapshot|null>(null);const [receipt,setReceipt]=useState<PairReceipt|null>(null);
+ const [phase,setPhase]=useState<Phase>('choose');const [mode,setMode]=useState<PairMode>('WITH_PARTNER');const [adding,setAdding]=useState(false);
+ const [partner,setPartner]=useState<Partner>({...emptyPartner});const [manual,setManual]=useState(false);const [query,setQuery]=useState('');const [activeField,setActiveField]=useState<FieldKey|null>(null);
+ const [matches,setMatches]=useState<Partner[]>([]);const [looking,setLooking]=useState(false);const [share,setShare]=useState(false);
+ const [candidates,setCandidates]=useState<Candidate[]|null>(null);const [target,setTarget]=useState<Candidate|null>(null);
+ const [busy,setBusy]=useState(false);const [loading,setLoading]=useState(true);const [uncertain,setUncertain]=useState(false);const [error,setError]=useState<AuthError|null>(null);
+ const [sharePreview,setSharePreview]=useState(false);const running=useRef(false);const version=useRef(0);
+ function problem(e:unknown) {const issue=e instanceof AuthError?e:new AuthError('UNAVAILABLE');setError(issue);
+  if(issue instanceof PairError&&issue.snapshot)setSnapshot(issue.snapshot);
+  if(issue instanceof PairError&&issue.matches){setMatches(issue.matches);setPhase('partner');setPartner(p=>({...p,id:undefined}));}
+  if(issue.code==='UNCERTAIN')setUncertain(true);
+ }
+ async function perform(fn:()=>Promise<void>){if(running.current)return;running.current=true;const started=version.current;setBusy(true);setError(null);
+  try{await fn();}catch(e){if(started===version.current)problem(e);}finally{running.current=false;if(started===version.current){setBusy(false);setLoading(false);}}
+ }
+ async function check(){const started=version.current;await perform(async()=>{const next=await gateway.reconcile(tournamentId);if(started!==version.current)return;setSnapshot(next.snapshot);setUncertain(next.uncertain);setReceipt(null);setPhase(next.snapshot.own.registered?'result':'choose');});}
+ useEffect(()=>{version.current++;void check();return()=>{version.current++;};},[gateway,tournamentId]);
+ const lookup=manual?(activeField?partner[activeField]:''):query;
+ useEffect(()=>{let alive=true;setMatches([]);if(phase!=='partner'||partner.id||lookup.trim().length<2){setLooking(false);return;}
+  setLooking(true);const timer=setTimeout(()=>{gateway.search(tournamentId,lookup).then(rows=>{if(alive)setMatches(rows);}).catch(e=>{if(alive)problem(e);}).finally(()=>{if(alive)setLooking(false);});},300);
+  return()=>{alive=false;clearTimeout(timer);};
+ },[gateway,tournamentId,lookup,phase,partner.id,manual]);
+ const event=snapshot?.event;const own=snapshot?.own;const status=receipt?.status??own?.status;
+ const closed=!!event&&(!event.registrationOpen||event.status!=='REGISTRO_ABIERTO'||Date.parse(event.startsAt)<=Date.now());
+ const ready=!!(own?.isDouble&&own.partnerId)||!!(receipt&&mode==='WITH_PARTNER'&&['CONFIRMED','WAITLIST'].includes(receipt.status));
+ const label=(status&&t[status as keyof typeof t])||t.result;
+ function choose(value:PairMode){setMode(value);setAdding(false);setError(null);setReceipt(null);setPhase(value==='WITH_PARTNER'?'partner':'solo');}
+ function edit(field:FieldKey,value:string){setPartner(p=>({...p,id:undefined,[field]:value}));setActiveField(field);setError(null);}
+ function select(p:Partner){setPartner({...p});setActiveField(null);setQuery('');setMatches([]);setError(null);}
+ async function external(url:string){try{if(demo){setSharePreview(true);return;}await Linking.openURL(url);}catch{setError(new AuthError('UNAVAILABLE'));}}
+ const shareText=event?`${messages[language][event.type]} · ${eventDate(event.startsAt,event.timeZone,language)} · ${event.club.name}\n${label}\nhttps://1-padel.com/app/?event=${event.id}`:'';
+ let errorText=t.unavailable;
+ if(error instanceof PlayerRequestError)errorText=error.needLevel?t.needLevel:error.detail||t.unavailable;
+ else if(error){const key:Record<string,keyof typeof t>={CHANGED:'changed',CLOSED:'closed',EXISTING:'existing',INVALID_PARTNER:'invalid',PARTNER_UNAVAILABLE:'unavailablePartner',MATCH_REQUIRED:'matchRequired',UNCERTAIN:'uncertain'};errorText=t[key[error.code]??'unavailable'];}
+ const allowRetry=!error||error.code==='CHANGED';
+ function beginAdd(){setAdding(true);setMode('WITH_PARTNER');setPartner({...emptyPartner});setReceipt(null);setError(null);setPhase('partner');}
+ function showCandidates(){const started=version.current;setCandidates(null);setPhase('candidates');void perform(async()=>{const rows=await gateway.candidates(tournamentId);if(started===version.current)setCandidates(rows);});}
+ function matchRows(){return !!matches.length&&<View style={s.notice}><Text style={s.section}>{t.matches}</Text>{matches.map(p=><TouchableOpacity key={p.id} accessibilityRole="button" accessibilityLabel={`${t.selected}: ${p.first} ${p.last}`} onPress={()=>select(p)} style={s.person}><View style={{flex:1}}><Text style={s.fact}>{p.first} {p.last}</Text><Text style={s.small}>{p.level||'—'}{p.phone?` · WhatsApp …${p.phone.replace(/\D/g,'').slice(-4)}`:''}</Text></View><Text style={s.link}>＋</Text></TouchableOpacity>)}</View>;}
+ return <KeyboardAvoidingView style={s.screen} behavior={Platform.OS==='ios'?'padding':undefined}>
+  <View style={s.top}><Button secondary title={`‹ ${t.back}`} disabled={busy} onPress={()=>{if(phase==='review'){setPhase(mode==='WITH_PARTNER'?'partner':'solo');setError(null);}else if(phase==='partner'||phase==='solo'){setPhase(own?.registered?'result':'choose');setError(null);}else onClose();}}/><Text accessibilityRole="header" style={s.title}>{phase==='review'?t.review:phase==='partner'?t.partnerTitle:phase==='choose'?t.choose:t.title}</Text></View>
+  {demo&&<Text style={s.demo}>{t.demo}</Text>}
+  <ScrollView keyboardShouldPersistTaps="handled" contentContainerStyle={s.content}>
+   {loading&&<View style={s.center}><ActivityIndicator color={c.orange}/><Text style={s.body}>{t.loading}</Text></View>}
