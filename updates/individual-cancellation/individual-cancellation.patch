new file mode 100644
--- /dev/null
+++ b/mobile-app/src/individualCancellation.ts
@@ -0,0 +1,85 @@
+import { AuthError, PlayerRequestError } from './auth.ts';
+import type { Registration } from './auth.ts';
+import type { PublicTournament } from './schedule.ts';
+import { cancellationDeadline, isIndividualEvent } from './individualBooking.ts';
+
+export type CancellationSnapshot = { event: PublicTournament; registration: Registration | null };
+export type CancellationReceipt = { alreadyInactive: boolean };
+export type CancellationTransport = {
+  sessionVersion?: () => number;
+  details: (id: number) => Promise<PublicTournament>;
+  registrations: () => Promise<Registration[]>;
+  cancelIndividual: (id: number, reason: string) => Promise<unknown>;
+};
+export class CancellationError extends AuthError {
+  snapshot?: CancellationSnapshot;
+  constructor(code: string, snapshot?: CancellationSnapshot) { super(code); this.snapshot = snapshot; }
+}
+export function cancellationBlock(snapshot: CancellationSnapshot, now = Date.now()): string | null {
+  const { event, registration } = snapshot;
+  if (!isIndividualEvent(event)) return 'NOT_INDIVIDUAL';
+  if (!registration) return 'INACTIVE';
+  if (!['CONFIRMED', 'WAITLIST', 'WAITLIST_INVITED'].includes(registration.status ?? '')) return 'UNSUPPORTED';
+  if (!Number.isFinite(Date.parse(event.startsAt)) || !Number.isFinite(Date.parse(cancellationDeadline(event)))) return 'UNAVAILABLE';
+  if (['FINALIZADO', 'CANCELADO', 'CERRADO'].includes(event.status) || Date.parse(event.startsAt) <= now) return 'CLOSED';
+  // Сервер использует now.isBefore(effectiveDeadline), в том числе для WAITLIST и Cancha.
+  if (now >= Date.parse(cancellationDeadline(event))) return 'DEADLINE';
+  return null;
+}
+export function cancellationQuote({ event, registration }: CancellationSnapshot) {
+  // Место в очереди само по себе не меняет согласие; переход WAITLIST→CONFIRMED меняет.
+  return JSON.stringify([event.id, event.type, event.modality, event.name, event.gender, event.level,
+    event.startsAt, event.timeZone, event.club, event.status, event.price, event.currency, event.description,
+    cancellationDeadline(event), registration?.status, registration?.registeredAt ?? null]);
+}
+export function cancellationTerms(event: PublicTournament, status: string | null) {
+  return event.type === 'CANCHA_ABIERTA' ? 'cancha' : status === 'CONFIRMED' ? 'financial' : 'waitlist';
+}
+export function createIndividualCancellation(transport: CancellationTransport) {
+  const version = transport.sessionVersion?.();
+  const pending = new Set<number>(); const uncertain = new Set<number>();
+  function checkAccount() { if (version !== transport.sessionVersion?.()) throw new AuthError('CANCELLED'); }
+  async function load(id: number): Promise<CancellationSnapshot> {
+    checkAccount();
+    if (!Number.isSafeInteger(id) || id < 1) throw new CancellationError('UNAVAILABLE');
+    const [event, rows] = await Promise.all([transport.details(id), transport.registrations()]);
+    checkAccount();
+    if (event.id !== id) throw new CancellationError('UNAVAILABLE');
+    return { event, registration: rows.find(row => row.event.id === id && row.active && row.status !== null && !['CANCELLED', 'PARTICIPATED', 'SOLO_EXPIRED'].includes(row.status)) ?? null };
+  }
+  return {
+    load,
+    isUncertain: (id: number) => uncertain.has(id),
+    async reconcile(id: number) {
+      const snapshot = await load(id);
+      if (!snapshot.registration) uncertain.delete(id);
+      return { snapshot, receipt: snapshot.registration ? null : { alreadyInactive: true }, uncertain: uncertain.has(id) };
+    },
+    async cancel(id: number, quote: string, reason = ''): Promise<CancellationReceipt> {
+      if (pending.has(id)) throw new CancellationError('BUSY');
+      if (uncertain.has(id)) throw new CancellationError('UNCERTAIN');
+      if (reason.length > 500) throw new CancellationError('REASON');
+      pending.add(id);
+      try {
+        const snapshot = await load(id);
+        if (!isIndividualEvent(snapshot.event)) throw new CancellationError('NOT_INDIVIDUAL', snapshot);
+        if (!snapshot.registration) return { alreadyInactive: true };
+        const block = cancellationBlock(snapshot);
+        if (block) throw new CancellationError(block, snapshot);
+        if (cancellationQuote(snapshot) !== quote) throw new CancellationError('CHANGED', snapshot);
+        checkAccount();
+        try {
+          const reply = await transport.cancelIndividual(id, reason.trim());
+          checkAccount();
+          if (!reply || typeof reply !== 'object' || Array.isArray(reply) || (reply as { success?: unknown }).success !== true) throw new Error('Invalid cancellation receipt');
+          return { alreadyInactive: false };
+        } catch (error) {
+          checkAccount();
+          // Достоверный отказ не выдаём за отмену. Любой неопределённый ответ — только сверка GET.
+          if (error instanceof PlayerRequestError || error instanceof AuthError && ['FORBIDDEN', 'RATE_LIMIT'].includes(error.code)) throw error;
+          uncertain.add(id); throw new CancellationError('UNCERTAIN');
+        }
+      } finally { pending.delete(id); }
+    },
+  };
+}
