@@ -0,0 +1,93 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { ActivityIndicator, KeyboardAvoidingView, Linking, Platform, ScrollView, StyleSheet, Text, TextInput, TouchableOpacity, View } from 'react-native';
+import { AuthError, PlayerRequestError } from './auth';
+import { cancellationDeadline } from './individualBooking';
+import { CancellationError, cancellationBlock, cancellationQuote, cancellationTerms } from './individualCancellation';
+import type { CancellationSnapshot, CancellationReceipt, createIndividualCancellation } from './individualCancellation';
+import { eventDate, eventPrice } from './schedule';
+import type { Language } from './schedule';
+import { messages } from './copy';
+import { cancellationCopy } from './cancellationCopy';
+import { colors as c } from './theme';
+
+export default function IndividualCancellationScreen({ tournamentId, cancellation, profileName, language, onClose, demo = false }: {
+  tournamentId: number; cancellation: ReturnType<typeof createIndividualCancellation>; profileName: string;
+  language: Language; onClose: () => void; demo?: boolean;
+}) {
+  const t = cancellationCopy[language];
+  const [snapshot, setSnapshot] = useState<CancellationSnapshot | null>(null);
+  const [receipt, setReceipt] = useState<CancellationReceipt | null>(null);
+  const [error, setError] = useState<AuthError | null>(null);
+  const [loading, setLoading] = useState(true); const [busy, setBusy] = useState(false);
+  const [accepted, setAccepted] = useState(false); const [reason, setReason] = useState('');
+  const [uncertain, setUncertain] = useState(false); const [checkedUncertain, setCheckedUncertain] = useState(false);
+  const [now, setNow] = useState(Date.now());
+  const version = useRef(0); const running = useRef(false);
+  function problem(value: unknown) {
+    const issue = value instanceof AuthError ? value : new AuthError('UNAVAILABLE');
+    if (issue instanceof CancellationError && issue.snapshot) setSnapshot(issue.snapshot);
+    setAccepted(false); setError(issue);
+    if (issue.code === 'UNCERTAIN') { setUncertain(true); setCheckedUncertain(false); }
+  }
+  async function perform(action: () => Promise<void>) {
+    if (running.current) return;
+    running.current = true; const started = version.current; setBusy(true); setError(null);
+    try { await action(); } catch (value) { if (started === version.current) problem(value); }
+    finally { running.current = false; if (started === version.current) { setBusy(false); setLoading(false); setNow(Date.now()); } }
+  }
+  async function check() {
+    const started = version.current; setAccepted(false);
