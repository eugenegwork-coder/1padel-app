+++ b/mobile-app/scripts/build-site.mjs
@@ -0,0 +1,12 @@
+import { spawnSync } from 'node:child_process';
+import { cpSync, mkdirSync, rmSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+const root = path.resolve(fileURLToPath(new URL('..', import.meta.url)));
+if (path.basename(root) !== 'mobile-app') throw new Error('Разместите исходники в mobile-app/ серверного репозитория.');
+const build = spawnSync(process.execPath, [path.join(root, 'node_modules/expo/bin/cli'), 'export', '--platform', 'web', '--output-dir', 'dist-auth-web'], { cwd: root, env: { ...process.env, PADEL_WEB_BASE_PATH: '/app' }, stdio: 'inherit' });
+if (build.status !== 0) process.exit(build.status ?? 1);
+const target = path.resolve(root, '../src/main/resources/static/app');
+rmSync(target, { recursive: true, force: true });
+mkdirSync(target, { recursive: true });
+cpSync(path.join(root, 'dist-auth-web'), target, { recursive: true });
diff --git a/mobile-app/README.md b/mobile-app/README.md
--- a/mobile-app/README.md
+++ b/mobile-app/README.md
@@ -21,7 +21,11 @@
 - «Мои мероприятия»: `GET /api/players/me/tournaments`. Предстоящие — со статусом записи и позицией в листе ожидания, история — только турниры (сервер не отдаёт статус записи для прошедших). Отменённые записи сервер не возвращает. Запись и отмена — на сайте.
 - Анонимный или просроченный запрос к `/api/**` сервер не отклоняет `401`, а редиректит на `/login`. Клиент запрашивает с `redirect: 'manual'` и считает такой ответ истёкшей сессией.
 
-Сессия: в браузере оба токена только в памяти вкладки (перезагрузка — повторный вход), в нативном приложении refresh — в Expo SecureStore. Пароль не сохраняется.
+Сессия сохраняется после обновления, закрытия вкладки и повторного открытия приложения в том же браузере и на том же домене. В браузере только refresh-токен хранится в `localStorage` под отдельным ключом `onepadel.app.refresh.v1`; access-токен остаётся в памяти. При запуске клиент обновляет токены через `/api/auth/refresh`, затем загружает актуальный профиль. Для почты и Google используется одно хранилище. В нативном приложении refresh остаётся в Expo SecureStore. Пароль, профиль и список мероприятий не сохраняются.
+
+«Выйти» удаляет сохранённый refresh; запоздавший ответ сервера не может восстановить вход после выхода. Истёкший или отклонённый refresh удаляется; временная ошибка сети сохраняет его для повторной попытки. Ошибки хранилища отображаются пользователю. HTTP-просмотр по Wi-Fi не читает и не сохраняет токены.
+
+Ограничения: срок действия задаёт сервер (по умолчанию refresh — 7 дней, при успешном обновлении выдаётся новый); очистка данных сайта и закрытие приватного сеанса сбрасывают вход. Разные браузеры и Safari/отдельная иконка на домашнем экране могут иметь отдельные хранилища. `localStorage` доступен JavaScript того же origin — это не HttpOnly-cookie; серверный cookie-сеанс можно рассмотреть отдельно. Токен не выводится в интерфейс, адреса запросов, логи или аналитику.
 
 ## Сборка и проверка
 
