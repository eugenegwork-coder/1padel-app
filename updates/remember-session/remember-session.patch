@@ -0,0 +1,29 @@
+import { AuthError } from './auth.ts';
+
+// Отдельный ключ приложения: выход не затрагивает другие данные сайта.
+export const browserRefreshKey = 'onepadel.app.refresh.v1';
+type RefreshStorage = Pick<Storage, 'getItem' | 'setItem' | 'removeItem'>;
+
+// Только refresh-токен. Пароль, профиль, мероприятия и access-токен не сохраняются.
+// Хранилище читается при обращении: Safari может запретить доступ к localStorage.
+export function createBrowserRefreshStore(getStorage: () => RefreshStorage | null, secure: boolean) {
+  return {
+    async get(): Promise<string | null> {
+      if (!secure) return null;
+      try { return getStorage()?.getItem(browserRefreshKey) || null; }
+      catch { throw new AuthError('STORAGE'); }
+    },
+    async set(token: string | null): Promise<void> {
+      if (token && !secure) throw new AuthError('INSECURE');
+      try {
+        const storage = getStorage();
+        if (!storage) {
+          if (token) throw new AuthError('STORAGE');
+          return;
+        }
+        if (token) storage.setItem(browserRefreshKey, token);
+        else storage.removeItem(browserRefreshKey);
+      } catch { throw new AuthError('STORAGE'); }
+    },
+  };
+}
