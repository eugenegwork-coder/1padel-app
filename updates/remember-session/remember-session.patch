diff --git a/mobile-app/tests/sessionPersistence.test.mjs b/mobile-app/tests/sessionPersistence.test.mjs
new file mode 100644
--- /dev/null
+++ b/mobile-app/tests/sessionPersistence.test.mjs
@@ -0,0 +1,125 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createAuthClient, parseSessionFragment } from '../src/auth.ts';
+import { browserRefreshKey, createBrowserRefreshStore } from '../src/browserRefreshStore.ts';
+
+function device() {
+  const values = new Map([['unrelated-site-data', 'keep']]);
+  return { values, getItem: key => values.get(key) ?? null, setItem: (key, value) => values.set(key, value), removeItem: key => values.delete(key) };
+}
+const player = { id: 4, email: 'player@example.test', nombreCompleto: 'Test Player' };
+const profile = { id: 4, email: player.email, name: player.nombreCompleto };
+const tokens = name => ({ accessToken: `access-${name}`, refreshToken: `refresh-${name}`, expiresIn: 60000 });
+const json = (value, status = 200) => new Response(JSON.stringify(value), { status, headers: { 'Content-Type': 'application/json' } });
+function backend() {
+  const calls = [];
+  return { calls, fetchImpl: async (url, init) => {
+    calls.push({ url, init });
+    if (url.endsWith('/login')) return json(tokens('login'));
+    if (url.endsWith('/refresh')) return json(tokens('restored'));
+    if (url.endsWith('/me')) return json(player);
+    if (url.endsWith('/tournaments')) return json({ upcoming: [], historical: [] });
+    throw new Error('Unexpected endpoint');
+  } };
+}
+
+test('email sign-in survives closing the client: a new instance refreshes and loads own profile and events', async () => {
+  const saved = device(); const api = backend();
+  const first = createAuthClient({ store: createBrowserRefreshStore(() => saved, true), fetchImpl: api.fetchImpl });
+  await first.login(player.email, 'test-only-password');
+  assert.equal(saved.values.get(browserRefreshKey), 'refresh-login');
+  assert.equal([...saved.values.values()].some(value => value.includes('access-') || value.includes('test-only-password') || value.includes(player.email)), false);
+
+  const reopened = createAuthClient({ store: createBrowserRefreshStore(() => saved, true), fetchImpl: api.fetchImpl });
+  assert.deepEqual(await reopened.restore(), profile);
+  assert.deepEqual(await reopened.registrations(), []);
+  const refresh = api.calls.find(call => call.url.endsWith('/refresh'));
+  assert.deepEqual(JSON.parse(refresh.init.body), { refreshToken: 'refresh-login' });
+  assert.equal(api.calls.filter(call => call.url.endsWith('/login')).length, 1);
+  assert.equal(api.calls.at(-1).init.headers.Authorization, 'Bearer access-restored');
+  assert.equal(saved.values.get(browserRefreshKey), 'refresh-restored');
+});
+
+test('Google sign-in also survives reopening and rotates the saved refresh token', async () => {
+  const saved = device(); const api = backend();
+  const first = createAuthClient({ store: createBrowserRefreshStore(() => saved, true), fetchImpl: api.fetchImpl });
+  await first.adopt(parseSessionFragment('#accessToken=google-access&refreshToken=google-refresh&expiresIn=60000'));
+  const reopened = createAuthClient({ store: createBrowserRefreshStore(() => saved, true), fetchImpl: api.fetchImpl });
+  assert.deepEqual(await reopened.restore(), profile);
+  assert.deepEqual(JSON.parse(api.calls.find(call => call.url.endsWith('/refresh')).init.body), { refreshToken: 'google-refresh' });
+  assert.equal(saved.values.get(browserRefreshKey), 'refresh-restored');
+});
+
+test('explicit sign-out removes only app credentials and reopening does not call the server', async () => {
+  const saved = device(); const api = backend(); const store = createBrowserRefreshStore(() => saved, true);
+  const first = createAuthClient({ store, fetchImpl: api.fetchImpl });
+  await first.login(player.email, 'test-only-password');
+  await first.logout();
+  const before = api.calls.length;
+  assert.equal(await createAuthClient({ store, fetchImpl: api.fetchImpl }).restore(), null);
+  assert.equal(api.calls.length, before);
+  assert.deepEqual([...saved.values], [['unrelated-site-data', 'keep']]);
+});
+
+test('expired refresh is removed and is not tried again after reopening', async () => {
+  const saved = device(); const store = createBrowserRefreshStore(() => saved, true); let requests = 0;
+  await store.set('expired-refresh');
+  const fetchImpl = async () => { requests++; return json({}, 400); };
+  await assert.rejects(createAuthClient({ store, fetchImpl }).restore(), { code: 'SESSION_EXPIRED' });
+  assert.equal(await createAuthClient({ store, fetchImpl }).restore(), null);
+  assert.equal(requests, 1);
+});
+
+test('offline reopening keeps credentials so retry works without another login', async () => {
+  const saved = device(); const store = createBrowserRefreshStore(() => saved, true); const api = backend();
+  await store.set('saved-refresh'); let offline = true;
+  const client = createAuthClient({ store, fetchImpl: (...args) => {
+    if (offline) throw new TypeError('offline');
+    return api.fetchImpl(...args);
+  } });
+  await assert.rejects(client.restore(), { code: 'NETWORK' });
+  assert.equal(saved.values.get(browserRefreshKey), 'saved-refresh');
+  offline = false;
+  assert.deepEqual(await client.restore(), profile);
+});
+
+test('Safari storage restrictions are reported and do not silently promise persistence', async () => {
+  const blocked = createBrowserRefreshStore(() => { throw new DOMException('Blocked', 'SecurityError'); }, true);
+  await assert.rejects(blocked.get(), { code: 'STORAGE' });
+  await assert.rejects(blocked.set('test-refresh'), { code: 'STORAGE' });
+  await assert.rejects(blocked.set(null), { code: 'STORAGE' });
+  const full = createBrowserRefreshStore(() => ({ ...device(), setItem: () => { throw new DOMException('Full', 'QuotaExceededError'); } }), true);
+  const api = backend();
+  await assert.rejects(createAuthClient({ store: full, fetchImpl: api.fetchImpl }).login(player.email, 'test-only-password'), { code: 'STORAGE' });
+  assert.equal(api.calls.length, 1); // Profile and personal events are not loaded after a failed save.
+});
+
+test('HTTP Wi-Fi preview neither reads saved credentials nor saves a new token', async () => {
+  let reads = 0;
+  const store = createBrowserRefreshStore(() => { reads++; return device(); }, false);
+  assert.equal(await store.get(), null);
+  await assert.rejects(store.set('test-refresh'), { code: 'INSECURE' });
+  assert.equal(reads, 0);
+});
+
+test('sign-out during refresh cannot write credentials back to persistent storage', async () => {
+  const saved = device(); const store = createBrowserRefreshStore(() => saved, true);
+  await store.set('existing-refresh'); let reply;
+  const waiting = new Promise(resolve => { reply = resolve; });
+  let started; const requested = new Promise(resolve => { started = resolve; });
+  const client = createAuthClient({ store, fetchImpl: async () => { started(); return waiting; } });
+  const restore = client.restore();
+  await requested; await client.logout(); reply(json(tokens('late')));
+  await assert.rejects(restore, { code: 'CANCELLED' });
+  assert.equal(await store.get(), null);
+});
+
+test('sign-out during the first storage read cancels restore before any refresh request', async () => {
+  let reply; let count = 0; let token = 'existing-refresh';
+  const store = { get: () => new Promise(resolve => { reply = resolve; }), set: async value => { token = value; } };
+  const client = createAuthClient({ store, fetchImpl: async () => { count++; return json(tokens('late')); } });
+  const restore = client.restore();
+  await client.logout(); reply('existing-refresh');
+  await assert.rejects(restore, { code: 'CANCELLED' });
+  assert.equal(token, null); assert.equal(count, 0);
+});
diff --git a/mobile-app/scripts/build-site.mjs b/mobile-app/scripts/build-site.mjs
